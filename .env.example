# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/streaming_db?retryWrites=true&w=majority

# Cache & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example_token

# Authentication Secrets
JWT_ACCESS_SECRET=super_secret_access_key_min_32_characters_long_123456
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_long_123456

# External Metadata API (TMDb)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Third-Party Watchlist Sync (Simkl)
SIMKL_CLIENT_ID=your_simkl_client_id
SIMKL_CLIENT_SECRET=your_simkl_client_secret
SIMKL_REDIRECT_URI=https://vardstrm.vercel.app/api/auth/simkl/callback

# Email Password Reset (Free SMTP - Brevo, Resend, Gmail SMTP, Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="VardStream" <noreply@vardstrm.vercel.app>

# Vercel Cron Security
CRON_SECRET=random_cron_secret_key_123456

# Nano Streaming API (Direct Play Engine)
NANO_API_URL=https://testingpys-nano-api.hf.space

# App Config
NEXT_PUBLIC_APP_URL=https://vardstrm.vercel.app
ADMIN_INITIAL_EMAIL=admin@vardsrm.local

